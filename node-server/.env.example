# prisma
DATABASE_URL="mysql://local:local_123!@192.168.100.216:3306/mes_lan"

# server config
SERVER_PORT=3000

# AUTHENTICATION INFO
AUTHENTICATION_FROM_NODE=true
LARAVEL_URL="https://your-laravel-domain.com"

# Cache
ODATA_CACHE_DURATION=600

# Machine channel status mapping (STATUS derivation; transport-agnostic)
CHANNEL_MAPPING_ENABLED=true
CHANNEL_MAPPING_INTERVAL_MS=2000
CHANNEL_PLC_STATUS_PATH=/api/status
CHANNEL_PLC_TIMEOUT_MS=3000
CHANNEL_MODBUS_PORT=502
MACHINE_CONFIG_CACHE_TTL_MS=10000
# Off by default: Modbus needs a second round trip (FC4) per PLC per tick to
# read counters, on top of the existing FC2 discrete-input read. Turn on only
# if you actually have channels in Counter mode to read.
CHANNEL_READ_COUNTS=false

# Machine calculation endpoints (/overview, /shift-breakdown, /detail)
# Short-TTL cache-aside — keep this low enough that it never visibly disagrees
# with a just-broadcast machine_status_runtime transition.
MACHINE_CALC_CACHE_TTL_MS=8000
# Realtime production events (Redis channel mes:production-events → socket
# machine_production_updated): trailing coalesce window, at most one push per window.
PRODUCTION_EVENT_COALESCE_MS=1000
# Requests with a from/to span wider than this are rejected (400), not silently
# unbounded-fetched.
MACHINE_CALC_MAX_RANGE_DAYS=400

# MQTT (only used by machines with read_from=MQTT)
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# {id_iot} segment => explicit per-device subscribe list from
# machine_has_configs.id_iot (DB-driven, refreshed every MQTT_TOPIC_WATCH_MS).
# {ip} segment => wildcard subscribe. No placeholder => one flat shared topic.
MQTT_TOPIC_TEMPLATE=machine/status
MQTT_TOPIC_WATCH_MS=5000
MQTT_STALENESS_MS=15000

# Machine data via Socket.IO (qpail-microservice)
# true  => machines with read_from=MQTT read inputs/counts from the Socket.IO event
#          below instead of the MQTT broker (the broker is not connected). Read once at boot.
# false => normal MQTT behaviour.
MACHINE_DATA_SOCKET=false
# Event name qpail-microservice emits (its config.json "cloud.event").
MACHINE_DATA_SOCKET_EVENT=qpail-device:status
# A reading older than this is treated as "no data". Keep >= 3x the microservice poll interval.
# Do not reuse MQTT_STALENESS_MS — it is tuned for the broker feed.
MACHINE_DATA_SOCKET_STALENESS_MS=10000
# Shared secret; when set, only sockets whose handshake auth.token matches may feed machine data.
MACHINE_DATA_SOCKET_TOKEN=
