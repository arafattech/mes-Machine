  clients         clients?     @relation(fields: [client_id], references: [id], onUpdate: NoAction, map: "invoices_client_id_foreign")
  users           users?       @relation(fields: [generated_by], references: [id], onUpdate: NoAction, map: "invoices_generated_by_foreign")
  sales_orders    sales_orders @relation(fields: [sales_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invoices_sales_order_id_foreign")

  @@index([client_id], map: "invoices_client_id_foreign")
  @@index([generated_by], map: "invoices_generated_by_foreign")
  @@index([sales_order_id], map: "invoices_sales_order_id_foreign")
}

model leave_approvals {
  id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  leave_request_id BigInt         @db.UnsignedBigInt
  employee_id      BigInt         @db.UnsignedBigInt
  status           String         @default("approved") @db.VarChar(255)
  approved_at      DateTime       @db.Timestamp(0)
  created_at       DateTime?      @db.Timestamp(0)
  updated_at       DateTime?      @db.Timestamp(0)
  employees        employees      @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "leave_approvals_employee_id_foreign")
  leave_requests   leave_requests @relation(fields: [leave_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "leave_approvals_leave_request_id_foreign")

  @@unique([leave_request_id, employee_id], map: "leave_approvals_leave_request_id_employee_id_unique")
  @@index([employee_id], map: "leave_approvals_employee_id_foreign")
}

model market_price_companies {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  custom_id     String?         @db.VarChar(255)
  is_active     Boolean         @default(true)
  name          String          @db.VarChar(255)
  created_at    DateTime?       @db.Timestamp(0)
  updated_at    DateTime?       @db.Timestamp(0)
  market_prices market_prices[]
}

model product_marketer_assignments {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  product_id BigInt    @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_marketer_assignments_product_id_foreign")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_marketer_assignments_user_id_foreign")

  @@unique([product_id, user_id], map: "product_marketer_assignments_product_id_user_id_unique")
  @@index([user_id], map: "product_marketer_assignments_user_id_foreign")
}

model sale_return_items {
  id                 BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  sales_return_id    BigInt            @db.UnsignedBigInt
  sale_order_item_id BigInt?           @db.UnsignedBigInt
  product_id         BigInt            @db.UnsignedBigInt
  returned_quantity  Int               @default(0)
  remark             String?           @db.VarChar(255)
  created_at         DateTime?         @db.Timestamp(0)
  updated_at         DateTime?         @db.Timestamp(0)
  products           products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sale_return_items_product_id_foreign")
  sale_order_items   sale_order_items? @relation(fields: [sale_order_item_id], references: [id], onUpdate: NoAction, map: "sale_return_items_sale_order_item_id_foreign")
  sales_returns      sales_returns     @relation(fields: [sales_return_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sale_return_items_sales_return_id_foreign")

  @@index([product_id], map: "sale_return_items_product_id_foreign")
  @@index([sale_order_item_id], map: "sale_return_items_sale_order_item_id_foreign")
  @@index([sales_return_id], map: "sale_return_items_sales_return_id_foreign")
}

model sales_returns {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  custom_id         String?             @db.VarChar(255)
  sales_order_id    BigInt              @db.UnsignedBigInt
  returned_by       BigInt?             @db.UnsignedBigInt
  return_date       DateTime?           @db.Date
  total_quantity    Int                 @default(0)
  reason            String?             @db.VarChar(255)
  remarks           String?             @db.Text
  created_at        DateTime?           @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  deleted_at        DateTime?           @db.Timestamp(0)
  sale_return_items sale_return_items[]
  users             users?              @relation(fields: [returned_by], references: [id], onUpdate: NoAction, map: "sales_returns_returned_by_foreign")
  sales_orders      sales_orders        @relation(fields: [sales_order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sales_returns_sales_order_id_foreign")

  @@index([returned_by], map: "sales_returns_returned_by_foreign")
  @@index([sales_order_id], map: "sales_returns_sales_order_id_foreign")
}

