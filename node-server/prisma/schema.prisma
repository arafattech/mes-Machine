generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model activity_logs {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  is_active       Boolean   @default(true)
  is_read         Boolean   @default(false)
  custom_id       String?   @db.VarChar(255)
  user_id         Int
  user_name       String?   @db.VarChar(255)
  user_email      String?   @db.VarChar(255)
  model_type      String?   @db.VarChar(255)
  model_id        Int?
  model_custom_id String?   @db.VarChar(255)
  action_type     String?   @db.VarChar(255)
  old_value       String?   @db.Text
  new_value       String?   @db.Text
  ip_address      String?   @db.VarChar(255)
  session_id      String?   @db.VarChar(255)
  deleted_at      DateTime? @db.Timestamp(0)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
}

model asset_groups {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  is_active  Boolean   @default(true)
  custom_id  String?   @db.VarChar(255)
  name       String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model assets {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  is_active           Boolean               @default(true)
  custom_id           String?               @db.VarChar(255)
  name                String                @db.VarChar(255)
  created_at          DateTime?             @db.Timestamp(0)
  updated_at          DateTime?             @db.Timestamp(0)
  employee_has_assets employee_has_assets[]
}

model attendance_logs {
  id                    BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  custom_id             String?          @db.VarChar(255)
  is_active             Boolean          @default(true)
  employee_id           BigInt?          @db.UnsignedBigInt
  shift_id              BigInt?          @db.UnsignedBigInt
  employee_no           Int?
  attendance_date       DateTime         @db.Date
  check_in_time         DateTime         @db.DateTime(0)
  check_out_time        DateTime?        @db.DateTime(0)
  over_time             DateTime?        @db.Time(0)
  created_at            DateTime?        @db.Timestamp(0)
  updated_at            DateTime?        @db.Timestamp(0)
  has_overtime          Boolean          @default(false)
  overtime_status       String?          @db.VarChar(255)
  is_ramadan_duty       Boolean          @default(false)
  is_holiday_bonus_duty Boolean          @default(false)
  ramadan_status        String?          @db.VarChar(255)
  holiday_bonus_status  String?          @db.VarChar(255)
  overtime_minutes      Int?
  status                String?          @db.VarChar(255)
  late_minutes          Int?
  device_ip             String?          @db.VarChar(255)
  employee_type_id      BigInt?          @db.UnsignedBigInt
  is_ot                 Boolean          @default(false)
  extra_shift_status    String?          @db.VarChar(255)
  employees             employees?       @relation(fields: [employee_id], references: [id], onUpdate: NoAction, map: "attendance_logs_employee_id_foreign")
  employee_types        employee_types?  @relation(fields: [employee_type_id], references: [id], onUpdate: NoAction, map: "attendance_logs_employee_type_id_foreign")
  employee_shifts       employee_shifts? @relation(fields: [shift_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attendance_logs_shift_id_foreign")

  @@unique([employee_no, attendance_date, check_in_time], map: "unique_attendance")
  @@index([attendance_date], map: "attendance_logs_attendance_date_index")
  @@index([employee_id], map: "attendance_logs_employee_id_index")
  @@index([employee_no], map: "attendance_logs_employee_no_index")
  @@index([employee_type_id], map: "attendance_logs_employee_type_id_foreign")
  @@index([shift_id], map: "attendance_logs_shift_id_index")
}

model biometrics_device_configs {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  custom_id  String?   @db.VarChar(255)
  is_active  Boolean   @default(true)
  name       String    @db.VarChar(255)
  ip         String    @unique(map: "biometrics_device_configs_ip_unique") @db.VarChar(255)
  port       Int       @default(4370)
  timeout    Int       @default(10000)
  inport     Int       @default(4000)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model bonus_configs {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  custom_id        String?            @unique(map: "bonus_configs_custom_id_unique") @db.VarChar(255)
  is_active        Boolean            @default(true)
  calculation_type String?            @db.VarChar(255)
  applicable_to    String?            @db.VarChar(255)
  name             String?            @db.VarChar(255)
  amount           Decimal?           @db.Decimal(12, 2)
  group_id         BigInt?            @db.UnsignedBigInt
  department_id    BigInt?            @db.UnsignedBigInt
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  bonus_type_id    BigInt?            @db.UnsignedBigInt
  employee_id      BigInt?            @db.UnsignedBigInt
  bonus_types      bonus_types?       @relation(fields: [bonus_type_id], references: [id], onUpdate: NoAction, map: "bonus_configs_bonus_type_id_foreign")
  departments      departments?       @relation(fields: [department_id], references: [id], onUpdate: NoAction, map: "bonus_configs_department_id_foreign")
  employees        employees?         @relation(fields: [employee_id], references: [id], onUpdate: NoAction, map: "bonus_configs_employee_id_foreign")
  employee_groups  employee_groups?   @relation(fields: [group_id], references: [id], onUpdate: NoAction, map: "bonus_configs_group_id_foreign")
  employee_bonuses employee_bonuses[]

  @@index([bonus_type_id], map: "bonus_configs_bonus_type_id_foreign")
  @@index([department_id], map: "bonus_configs_department_id_foreign")
  @@index([employee_id], map: "bonus_configs_employee_id_foreign")
  @@index([group_id], map: "bonus_configs_group_id_foreign")
}

model bonus_types {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  name          String?         @unique(map: "bonus_types_name_unique") @db.VarChar(255)
  created_at    DateTime?       @db.Timestamp(0)
  updated_at    DateTime?       @db.Timestamp(0)
  bonus_configs bonus_configs[]
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model capacities {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  is_active  Boolean   @default(true)
  custom_id  String?   @db.VarChar(255)
  name       String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model client_areas {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  is_active        Boolean            @default(true)
  custom_id        String?            @db.VarChar(255)
  name             String             @db.VarChar(255)
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  client_has_areas client_has_areas[] @ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model client_has_areas {

  client_id      BigInt       @db.UnsignedBigInt
  client_area_id BigInt       @db.UnsignedBigInt
  client_areas   client_areas @relation(fields: [client_area_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_has_areas_client_area_id_foreign")
  clients        clients      @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_has_areas_client_id_foreign")

  @@index([client_area_id], map: "client_has_areas_client_area_id_foreign")
  @@index([client_id], map: "client_has_areas_client_id_foreign")

  @@id([client_area_id, client_id])

}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model client_has_notes {

  client_id      BigInt       @db.UnsignedBigInt
  client_note_id BigInt       @db.UnsignedBigInt
  clients        clients      @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_has_notes_client_id_foreign")
  client_notes   client_notes @relation(fields: [client_note_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_has_notes_client_note_id_foreign")

  @@index([client_id], map: "client_has_notes_client_id_foreign")
  @@index([client_note_id], map: "client_has_notes_client_note_id_foreign")

  @@id([client_id, client_note_id])

}

model client_notes {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  is_active        Boolean            @default(true)
  custom_id        String?            @db.VarChar(255)
  name             String             @db.VarChar(255)
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  client_has_notes client_has_notes[] @ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model client_product {

  product_id BigInt   @db.UnsignedBigInt
  client_id  BigInt   @db.UnsignedBigInt
  clients    clients  @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_product_client_id_foreign")
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_product_product_id_foreign")

  @@index([client_id], map: "client_product_client_id_foreign")
  @@index([product_id], map: "client_product_product_id_foreign")

  @@id([client_id, product_id])

}

model clients {
  id                          BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  is_active                   Boolean            @default(true)
  custom_id                   String?            @db.VarChar(255)
  name                        String             @db.VarChar(255)
  first_contact_person_name   String?            @db.VarChar(255)
  first_contact_person_phone  String?            @db.VarChar(255)
  second_contact_person_name  String?            @db.VarChar(255)
  second_contact_person_phone String?            @db.VarChar(255)
  email                       String?            @db.VarChar(255)
  address                     String?            @db.Text
  bill_to                     String?            @db.Text
  ship_to                     String?            @db.Text
  note                        String?            @db.VarChar(255)
  tin                         String?            @db.VarChar(255)
  bin                         String?            @db.VarChar(255)
  created_at                  DateTime?          @db.Timestamp(0)
  updated_at                  DateTime?          @db.Timestamp(0)
  client_has_areas            client_has_areas[] @ignore
  client_has_notes            client_has_notes[] @ignore
  client_product              client_product[]   @ignore
  invoices                    invoices[]
  sales_orders                sales_orders[]
}

model config_has_channels {
  id                  BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  config_id           BigInt                     @db.UnsignedBigInt
  channel_id          Int                        @db.UnsignedTinyInt
  status              config_has_channels_status @default(inactive)
  machine_state_id    BigInt?                    @db.UnsignedBigInt
  created_at          DateTime?                  @db.Timestamp(0)
  updated_at          DateTime?                  @db.Timestamp(0)
  machine_has_configs machine_has_configs        @relation(fields: [config_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "config_has_channels_config_id_foreign")
  machine_states      machine_states?            @relation(fields: [machine_state_id], references: [id], onUpdate: NoAction, map: "config_has_channels_machine_state_id_foreign")

  @@index([config_id], map: "config_has_channels_config_id_foreign")
  @@index([machine_state_id], map: "config_has_channels_machine_state_id_foreign")
}

model count_types {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  custom_id             String?                 @db.VarChar(255)
  name                  String?                 @db.VarChar(255)
  prefix                String?                 @db.VarChar(255)
  is_active             Boolean                 @default(true)
  created_at            DateTime?               @db.Timestamp(0)
  updated_at            DateTime?               @db.Timestamp(0)
  production_lot_counts production_lot_counts[]
}

model defect_reasons {
  id                       BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  is_active                Boolean                    @default(true)
  custom_id                String?                    @db.VarChar(255)
  name                     String                     @db.VarChar(255)
  code                     String?                    @unique(map: "defect_reasons_code_unique") @db.VarChar(50)
  created_at               DateTime?                  @db.Timestamp(0)
  updated_at               DateTime?                  @db.Timestamp(0)
  material_inspection_logs material_inspection_logs[]
  quality_inspections      quality_inspections[]
}

model defects {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  code               String               @unique(map: "defects_code_unique") @db.VarChar(255)
  name               String               @db.VarChar(255)
  category           String?              @db.VarChar(255)
  is_active          Boolean              @default(true)
  created_at         DateTime?            @db.Timestamp(0)
  updated_at         DateTime?            @db.Timestamp(0)
  inspection_defects inspection_defects[]
}

model department_stock_balances {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  department_id BigInt      @db.UnsignedBigInt
  product_id    BigInt      @db.UnsignedBigInt
  quantity      Int         @default(0)
  created_at    DateTime?   @db.Timestamp(0)
  updated_at    DateTime?   @db.Timestamp(0)
  departments   departments @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "department_stock_balances_department_id_foreign")
  products      products    @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "department_stock_balances_product_id_foreign")

  @@unique([department_id, product_id], map: "department_stock_balances_department_id_product_id_unique")
  @@index([product_id], map: "department_stock_balances_product_id_foreign")
}

model departments {
  id                                                   BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  custom_id                                            String?                     @db.VarChar(255)
  name                                                 String                      @db.VarChar(255)
  is_active                                            Boolean                     @default(true)
  created_at                                           DateTime?                   @db.Timestamp(0)
  updated_at                                           DateTime?                   @db.Timestamp(0)
  bonus_configs                                        bonus_configs[]
  department_stock_balances                            department_stock_balances[]
  employee_bonuses                                     employee_bonuses[]
  employees                                            employees[]
  item_returns                                         item_returns[]
  material_issues                                      material_issues[]
  material_receipts                                    material_receipts[]
  notices_departments                                  notices_departments[]
  promotion_configurations                             promotion_configurations[]
  promotions_promotions_new_department_idTodepartments promotions[]                @relation("promotions_new_department_idTodepartments")
  promotions_promotions_old_department_idTodepartments promotions[]                @relation("promotions_old_department_idTodepartments")
  purchase_orders                                      purchase_orders[]
  purchase_requisitions                                purchase_requisitions[]
}

model designations {
  id                                                     BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  custom_id                                              String?      @db.VarChar(255)
  name                                                   String       @db.VarChar(255)
  is_active                                              Boolean      @default(true)
  created_at                                             DateTime?    @db.Timestamp(0)
  updated_at                                             DateTime?    @db.Timestamp(0)
  employees                                              employees[]
  promotions_promotions_new_designation_idTodesignations promotions[] @relation("promotions_new_designation_idTodesignations")
  promotions_promotions_old_designation_idTodesignations promotions[] @relation("promotions_old_designation_idTodesignations")
}

model employee_bank_infos {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  employee_id         BigInt    @db.UnsignedBigInt
  is_primary          Boolean   @default(false)
  is_active           Boolean   @default(true)
  bank_name           String?   @db.Text
  branch_name         String?   @db.Text
  account_number      String?   @db.Text
  account_holder_name String?   @db.Text
  swift_code          String?   @db.Text
  created_at          DateTime? @db.Timestamp(0)
  updated_at          DateTime? @db.Timestamp(0)
  employees           employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "employee_bank_infos_employee_id_foreign")

  @@index([employee_id], map: "employee_bank_infos_employee_id_foreign")
}

model employee_blacklists {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  employee_id   BigInt    @db.UnsignedBigInt
  is_active     Boolean   @default(true)
  custom_id     String?   @db.VarChar(255)
  reason        String    @db.VarChar(255)
  added_by      BigInt?   @db.UnsignedBigInt
  remarks       String?   @db.Text
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  status        Boolean   @default(false)
  revoke_reason String?   @db.LongText
  employees     employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "employee_blacklists_employee_id_foreign")

  @@index([employee_id], map: "employee_blacklists_employee_id_foreign")
}

model employee_bonuses {
  id                  BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  bonus_type          String           @db.VarChar(255)
  amount              Decimal          @db.Decimal(10, 2)
  description         String?          @db.VarChar(500)
  created_at          DateTime?        @db.Timestamp(0)
  updated_at          DateTime?        @db.Timestamp(0)
  group_id            BigInt?          @db.UnsignedBigInt
  emp_id              BigInt?          @db.UnsignedBigInt
  config_id           BigInt?          @db.UnsignedBigInt
  department_id       BigInt?          @db.UnsignedBigInt
  attendance_log_id   BigInt?          @db.UnsignedBigInt
  shift_id            BigInt?          @db.UnsignedBigInt
  attendance_date     DateTime?        @db.Date
  overtime_minutes    Int?             @db.UnsignedInt
  calculation_type    String?          @db.VarChar(255)
  bonus_config_amount Decimal?         @db.Decimal(12, 2)
  bonus_type_id       BigInt?          @db.UnsignedBigInt
  source_type         String?          @db.VarChar(255)
  remarks             String?          @db.VarChar(500)
  status              String?          @db.VarChar(255)
  bonus_configs       bonus_configs?   @relation(fields: [config_id], references: [id], onUpdate: NoAction, map: "employee_bonuses_config_id_foreign")
  departments         departments?     @relation(fields: [department_id], references: [id], onUpdate: NoAction, map: "employee_bonuses_department_id_foreign")
  employees           employees?       @relation(fields: [emp_id], references: [id], onUpdate: NoAction, map: "employee_bonuses_emp_id_foreign")
  employee_groups     employee_groups? @relation(fields: [group_id], references: [id], onUpdate: NoAction, map: "employee_bonuses_group_id_foreign")

  @@index([config_id], map: "employee_bonuses_config_id_foreign")
  @@index([department_id], map: "employee_bonuses_department_id_foreign")
  @@index([emp_id], map: "employee_bonuses_emp_id_foreign")
  @@index([group_id], map: "employee_bonuses_group_id_foreign")
}

model employee_groups {
  id                       BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  name                     String                     @db.VarChar(255)
  is_active                Boolean                    @default(true)
  is_permanent             Boolean                    @default(false)
  shift_id                 BigInt?                    @db.UnsignedBigInt
  custom_id                String?                    @db.VarChar(255)
  created_at               DateTime?                  @db.Timestamp(0)
  updated_at               DateTime?                  @db.Timestamp(0)
  bonus_configs            bonus_configs[]
  employee_bonuses         employee_bonuses[]
  employee_shifts          employee_shifts?           @relation(fields: [shift_id], references: [id], onUpdate: NoAction, map: "employee_groups_shift_id_foreign")
  employees                employees[]
  promotion_configurations promotion_configurations[]
  roster_has_groups        roster_has_groups[]        @ignore
  rosters                  rosters[]

  @@index([shift_id], map: "employee_groups_shift_id_foreign")
}

model employee_has_assets {
  id          BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  employee_id BigInt?    @db.UnsignedBigInt
  asset_id    BigInt?    @db.UnsignedBigInt
  issued_date DateTime?  @db.Date
  return_date DateTime?  @db.Date
  remarks     String?    @db.LongText
  note        String?    @db.LongText
  is_active   Boolean    @default(true)
  custom_id   String     @unique(map: "employee_has_assets_custom_id_unique") @db.VarChar(255)
  created_at  DateTime?  @db.Timestamp(0)
  updated_at  DateTime?  @db.Timestamp(0)
  assets      assets?    @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "employee_has_assets_asset_id_foreign")
  employees   employees? @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "employee_has_assets_employee_id_foreign")

  @@index([asset_id], map: "employee_has_assets_asset_id_foreign")
  @@index([employee_id], map: "employee_has_assets_employee_id_foreign")
}

model employee_holiday_swaps {
  id                    BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  employee_id           BigInt             @db.UnsignedBigInt
  weekend_id            BigInt?            @db.UnsignedBigInt
  original_holiday_date DateTime           @db.Date
  swapped_holiday_date  DateTime           @db.Date
  type                  String?            @default("HOLIDAY") @db.VarChar(255)
  status                String?            @default("APPROVED") @db.VarChar(255)
  reason                String?            @db.VarChar(255)
  created_at            DateTime?          @db.Timestamp(0)
  updated_at            DateTime?          @db.Timestamp(0)
  is_active             Boolean            @default(true)
  employees             employees          @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "employee_holiday_swaps_employee_id_foreign")
  employee_weekends     employee_weekends? @relation(fields: [weekend_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "employee_holiday_swaps_weekend_id_foreign")

  @@unique([employee_id, original_holiday_date], map: "employee_holiday_swaps_employee_id_original_holiday_date_unique")
  @@index([weekend_id], map: "employee_holiday_swaps_weekend_id_foreign")
}

model employee_salaries {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  title               String?   @db.VarChar(255)
  employee_id         BigInt    @db.UnsignedBigInt
  total_salary        Decimal   @default(0.00) @db.Decimal(10, 2)
  basic               Decimal   @default(0.00) @db.Decimal(10, 2)
  house_rent          Decimal   @default(0.00) @db.Decimal(10, 2)
  medical_allowance   Decimal   @default(0.00) @db.Decimal(10, 2)
  transport_allowance Decimal   @default(0.00) @db.Decimal(10, 2)
  other_allowance     Decimal   @default(0.00) @db.Decimal(10, 2)
  created_at          DateTime? @db.Timestamp(0)
  updated_at          DateTime? @db.Timestamp(0)
  employees           employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "employee_salaries_employee_id_foreign")

  @@index([employee_id], map: "employee_salaries_employee_id_foreign")
}

model employee_salary_details {
  id                 BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  employee_id        BigInt        @db.UnsignedBigInt
  net_amount         Decimal       @default(0.00) @db.Decimal(15, 2)
  salary_type_id     BigInt?       @db.UnsignedBigInt
  salary_type_name   String        @db.VarChar(255)
  salary_type_amount Decimal       @default(0.00) @db.Decimal(15, 2)
