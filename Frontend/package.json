{
  "name": "my-angular-csr",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prebuild": "node tools/prebuild.js",
    "postinstall": "npm run prebuild",
    "prestart": "npm run prebuild",
    "start": "ng serve",
    "prestart:de": "npm run prebuild",
    "start:de": "ng serve --configuration=bn",
    "build": "node --max_old_space_size=4096 ./node_modules/@angular/cli/bin/ng build",
    "prebuild:fast": "npm run prebuild",
    "build:fast": "ng build --configuration development",
    "prewatch": "npm run prebuild",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "i18n:extract": "ng xi18n --output-path src/locale",
    "extract-i18n": "ng extract-i18n my-angular-csr --format xlf --output-path src/locale && ng run my-angular-csr:xliffmerge"
  },
  "private": true,
  "dependencies": {
    "@amcharts/amcharts4": "^4.10.40",
    "@angular/animations": "^17.3.0",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@fullcalendar/angular": "^6.1.19",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@kolkov/angular-editor": "3.0.0-beta.2",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "@ui5/theming-ngx": "0.3.0",
    "@ui5/webcomponents": "2.0.1",
    "@ui5/webcomponents-base": "2.0.1",
    "@ui5/webcomponents-fiori": "2.0.1",
    "@ui5/webcomponents-localization": "2.0.1",
    "@ui5/webcomponents-ngx": "0.3.0",
    "@zxing/ngx-scanner": "^17.0.4",
    "ag-grid-angular": "^34.3.0",
    "ag-grid-community": "^34.3.0",
    "chart.js": "^4.5.0",
    "i": "^0.3.7",
    "moment": "^2.30.1",
    "ng-lazyload-image": "^9.1.3",
    "ng2-charts": "^5.0.4",
    "ngx-doc-viewer": "^15.0.1",
    "ngx-webcam": "^0.4.1",
    "npm": "^11.1.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.11",
    "@angular/cli": "^17.3.11",
    "@angular/compiler-cli": "^17.3.0",
    "@angular/localize": "^17.3.12",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.20",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.4.2"
  }
}
